# --- The personal layer: never committed (the code/data seam) ---
# All instance state, indexes, caches, and canonical personal files.
data/
data

# Real screenshots, private design docs, the private data map.
docs/

# The private operational spec for this instance (a scrubbed README ships
# in its place).
CLAUDE.md

# System-atlas explainer: diagram exports carry instance-specific detail.
static/explainer/

# Personal reading room: pages built from the private self-record.
static/reading/
# Migrated site documents + hook-rendered plans: personal, served at /docs/.
static/docs/

# Local Claude Code project config (absolute paths, permission grants).
.claude/

# --- Android companion app (android/) ---
android/.gradle/
android/local.properties
android/**/build/
android/.kotlin/

# --- Environment / runtime ---
# Branch worktrees (scripts/branch.sh start). They live inside the checkout so
# they stay out of ~/workspace, where they read as projects. This entry is
# load-bearing, not tidiness: without it `git status` on the live tree reports
# every worktree as untracked and the merge preflight refuses every merge.
.worktrees/
# Branch-worktree test instances (scripts/branch.sh serve)
.test-instance.*
# no trailing slash: branch worktrees carry .venv as a SYMLINK to the live venv
.venv
__pycache__/
*.pyc
*.log
.DS_Store
run-taurid.sh

# WhatsApp sidecar: pinned via package-lock.json; the tree itself never commits
bridge/whatsapp/node_modules/

# Session retrospectives: project-local working docs — never on the public repo
retros/

# Agent/browser verification artifacts written INTO the live checkout.
# These are not tidiness: scripts/branch.sh merge preflights the live tree
# with plain `git status --porcelain`, which counts UNTRACKED files — so
# one stray artifact here blocks EVERY session's merge, whatever it was
# working on. Playwright MCP writes .playwright-mcp/ into the repo root
# because the repo is its allowed root, and screenshots land beside it.
# CLAUDE.md used to carry a manual ritual ("delete these before merging");
# a rule a person has to remember is a rule that fails under parallelism,
# so it is encoded here instead.
/.playwright-mcp/
# Root-level only — static/*.png are real tracked assets and stay tracked.
/*.png
