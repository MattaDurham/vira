    "data/review-queue.json",
    "data/lesson-watch.json"
  ],
  "reads": [
    "work/ideas",
    "work/sessions"
  ],
  "feeds": [
    "attention/now"
  ],
  "registry": [
    "review-engine",
    "lesson-recurrence"
  ]
}
